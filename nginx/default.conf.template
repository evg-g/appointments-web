# nginx config for the Aurora web tier.
#
# It does two jobs:
#   1. Serve the built single-page app, with a history-API fallback so client-side routes
#      (/appointments, /cold-chain, ...) all return index.html instead of 404.
#   2. Reverse-proxy the API on the *same origin* under /api and /health, so the browser sees one
#      origin (no CORS) and the app's default base URL (window.location.origin, see
#      src/api/client.ts) just works with no build-time API URL baked in.
#
# The API upstream is injected at container start from the ${API_UPSTREAM} environment variable —
# the nginx image runs envsubst over /etc/nginx/templates/*.template before starting, and only
# substitutes names that are actually set in the environment, so nginx's own $host/$uri/etc. are
# left untouched. Default is the compose service name `api:8000`; in Azure it points at the API
# container app.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Never serve a stale shell: index.html changes every deploy and is tiny.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/aurora-security-headers.conf;
    }

    # Vite content-hashes every asset filename, so these can be cached hard and immutably.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API traffic. Proxied to the backend on the same origin.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The telemetry SSE stream (/api/v1/streams/telemetry) is long-lived and must not be
        # buffered, or the browser sees no events until the connection closes.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Health probes (/health/live, /health/ready) also live on the API.
    location /health/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    # SPA history fallback for every other path.
    location / {
        include /etc/nginx/aurora-security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
