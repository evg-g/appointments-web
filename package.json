{
  "name": "appointments-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Aurora Clinic appointment scheduling and cold-chain monitoring web app",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:client": "openapi-typescript contracts/openapi.json -o src/api/schema.d.ts",
    "vendor:contract": "bash scripts/vendor-contract.sh",
    "check:client": "npm run generate:client && git diff --exit-code -- src/api/schema.d.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "build:e2e": "VITE_ENABLE_MSW=true vite build --outDir dist-e2e",
    "build:demo": "VITE_ENABLE_MSW=true VITE_MSW_DEMO_DATA=true vite build --outDir dist-demo",
    "screenshots": "playwright test -c playwright.showcase.config.ts",
    "e2e:pages": "playwright test -c playwright.pages.config.ts",
    "build:pages": "VITE_ENABLE_MSW=true VITE_MSW_DEMO_DATA=true vite build --outDir dist-pages --base /appointments-web/ && cp dist-pages/index.html dist-pages/404.html",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4173 --strictPort",
    "preview:prod": "vite preview --outDir dist --port 4180 --strictPort",
    "e2e": "playwright test",
    "e2e:composed": "playwright test -c playwright.composed.config.ts",
    "e2e:journeys": "playwright test journeys",
    "e2e:a11y": "playwright test a11y",
    "e2e:visual": "playwright test visual",
    "e2e:update-snapshots": "playwright test visual --update-snapshots",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "smoke": "node scripts/smoke_test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "openapi-fetch": "^0.13.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.13.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^9.1.20",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.12.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
