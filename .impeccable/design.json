  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled action per view.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z\"/><path d=\"M12 14v4M10 16h4\"/></svg>Book appointment</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:var(--text-sm);font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color var(--duration-fast) var(--ease-standard),color var(--duration-fast) var(--ease-standard);border:none;background:var(--color-accent);color:var(--color-accent-fg);}.ds-btn-primary:hover{background:var(--color-accent-hover);}.ds-btn-primary:active{background:var(--color-accent-active);}.ds-btn-primary:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Alternative actions beside a primary.",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">Calendar</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:var(--text-sm);font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color var(--duration-fast) var(--ease-standard),color var(--duration-fast) var(--ease-standard);border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text);}.ds-btn-secondary:hover{background:var(--color-surface-sunken);}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive actions only (cancel appointment).",
      "html": "<button class=\"ds-btn-danger\" type=\"button\">Cancel appointment</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:var(--radius-md);font-family:var(--font-sans);font-size:var(--text-sm);font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color var(--duration-fast) var(--ease-standard),color var(--duration-fast) var(--ease-standard);border:none;background:var(--color-danger);color:var(--color-text-inverse);}.ds-btn-danger:hover{opacity:.9;}.ds-btn-danger:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled input; teal border on focus, red when invalid.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Email <span class=\"ds-req\" aria-hidden=\"true\">*</span></span><input class=\"ds-input\" type=\"email\" placeholder=\"you@clinic.example\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family:var(--font-sans);max-width:320px;}.ds-field-label{font-size:var(--text-sm);font-weight:500;color:var(--color-text);}.ds-req{color:var(--color-danger-fg);}.ds-input{height:40px;padding:0 12px;border:1px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-surface);color:var(--color-text);font:inherit;font-size:var(--text-sm);transition:border-color var(--duration-fast) var(--ease-standard);}.ds-input::placeholder{color:var(--color-text-subtle);}.ds-input:focus{border-color:var(--color-accent);}.ds-input:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;border-radius:var(--radius-md);}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-accent",
      "description": "One badge color per appointment status.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge ds-badge-accent\">Confirmed</span><span class=\"ds-badge ds-badge-info\">Requested</span><span class=\"ds-badge ds-badge-success\">Completed</span><span class=\"ds-badge ds-badge-warning\">No-show</span><span class=\"ds-badge ds-badge-neutral\">Cancelled</span></div>",
      "css": ".ds-badges{display:flex;gap:8px;flex-wrap:wrap;font-family:var(--font-sans);}.ds-badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:500;}.ds-badge-accent{background:var(--color-accent-subtle);color:var(--color-accent-subtle-fg);}.ds-badge-info{background:var(--color-info-bg);color:var(--color-info-fg);}.ds-badge-success{background:var(--color-success-bg);color:var(--color-success-fg);}.ds-badge-warning{background:var(--color-warning-bg);color:var(--color-warning-fg);}.ds-badge-neutral{background:var(--color-surface-sunken);color:var(--color-text-muted);}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Paper surface with a hairline border and Whisper shadow.",
      "html": "<div class=\"ds-card\"><h3 class=\"ds-card-title\">Upcoming appointments</h3><p class=\"ds-card-desc\">Soonest first.</p><div class=\"ds-card-row\"><span class=\"ds-tab\">Sep 30, 2026, 10:00 AM</span><span class=\"ds-badge-mini\">Confirmed</span></div></div>",
      "css": ".ds-card{max-width:420px;padding:20px;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-sm);font-family:var(--font-sans);}.ds-card-title{margin:0;font-size:var(--text-lg);font-weight:600;letter-spacing:var(--tracking-tight);color:var(--color-text);}.ds-card-desc{margin:4px 0 12px;font-size:var(--text-sm);color:var(--color-text-muted);}.ds-card-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-top:1px solid var(--color-border);font-size:var(--text-sm);color:var(--color-text);}.ds-tab{font-variant-numeric:tabular-nums;}.ds-badge-mini{padding:2px 8px;border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:500;background:var(--color-accent-subtle);color:var(--color-accent-subtle-fg);}"
    },
    {
      "name": "Primary Navigation",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Header links; the active item sits on the teal wash; labels never wrap.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><a class=\"ds-nav-link\" href=\"#\">Dashboard</a><a class=\"ds-nav-link\" href=\"#\">Appointments</a><a class=\"ds-nav-link ds-nav-active\" href=\"#\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0z\"/></svg>Cold chain</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;font-family:var(--font-sans);}.ds-nav-link{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:var(--radius-md);font-size:var(--text-sm);font-weight:500;white-space:nowrap;text-decoration:none;color:var(--color-text-muted);transition:background-color var(--duration-fast) var(--ease-standard);}.ds-nav-link:hover{background:var(--color-surface-sunken);color:var(--color-text);}.ds-nav-link:focus-visible{outline:2px solid var(--color-focus-ring);outline-offset:2px;}.ds-nav-active,.ds-nav-active:hover{background:var(--color-accent-subtle);color:var(--color-accent-subtle-fg);}"
    },
    {
      "name": "Temperature Chart",
      "kind": "custom",
      "refersTo": null,
      "description": "The signature instrument: safe band, one teal line, live dot, hairline axes.",
      "html": "<figure class=\"ds-chart\"><div class=\"ds-readout\">4.7 °C</div><svg viewBox=\"0 0 320 120\" role=\"img\" aria-label=\"Temperature over time, one excursion above the safe band\"><rect x=\"24\" y=\"30\" width=\"288\" height=\"60\" class=\"ds-band\"/><line x1=\"24\" y1=\"8\" x2=\"24\" y2=\"104\" class=\"ds-axis\"/><line x1=\"24\" y1=\"104\" x2=\"312\" y2=\"104\" class=\"ds-axis\"/><path d=\"M24 66 C60 58 90 60 120 70 S170 72 190 62 L200 14 L226 16 L234 64 C260 72 290 74 310 70\" class=\"ds-line\"/><circle cx=\"310\" cy=\"70\" r=\"3.5\" class=\"ds-dot\"/><text x=\"2\" y=\"12\" class=\"ds-tick\">10.7</text><text x=\"2\" y=\"104\" class=\"ds-tick\">0.9</text></svg></figure>",
      "css": ".ds-chart{margin:0;max-width:420px;padding:20px;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);font-family:var(--font-sans);}.ds-readout{font-size:var(--text-3xl);font-weight:600;letter-spacing:var(--tracking-tight);font-variant-numeric:tabular-nums;color:var(--color-text);margin-bottom:8px;}.ds-band{fill:var(--color-success);opacity:.12;}.ds-axis{stroke:var(--color-border);stroke-width:1;}.ds-line{fill:none;stroke:var(--color-accent);stroke-width:2;stroke-linejoin:round;}.ds-dot{fill:var(--color-accent);}.ds-tick{font-size:10px;fill:var(--color-text-subtle);}"
